#!/usr/bin/env bash
case ${FORGE_UNAME:-$OSTYPE} in
  darwin*)
    if ! date --version >/dev/null 2>&1; then
      for _h in /opt/homebrew /usr/local; do
        [ ! -d "$_h/bin" ] || PATH=$PATH:$_h/bin
        for _p in bash/bin coreutils/libexec/gnubin findutils/libexec/gnubin gnu-sed/libexec/gnubin grep/libexec/gnubin util-linux/bin flock/bin rsync/bin; do
          [ ! -d "$_h/opt/$_p" ] || PATH=$_h/opt/$_p:$PATH
        done
      done
    fi
    PATH=$PATH:/usr/sbin:/sbin
    export PATH
    if [ "${BASH_VERSINFO:-0}" -lt 4 ]; then
      _b=$(command -v bash)
      [ "$("$_b" -c 'echo "${BASH_VERSINFO:-0}"')" -ge 4 ] || { echo "forge: needs Bash 4 or newer; run: brew install bash" >&2; exit 1; }
      exec "$_b" "$0" "$@"
    fi ;;
esac
set -euo pipefail
shopt -s nullglob

usage() {
  printf "usage: forge-init <name> <description> [<repo>=<description>...]\nRun 'forge-init --help' for details.\n" >&2
  exit 2
}

case ${1:-} in
  --help|-h)
    cat <<'EOF'
Usage: forge-init <name> <description> [<repo>=<description>...]

Set up forge in the current directory: a workspace whose direct
subdirectories are git repos, or a single-repo project (a workspace of
one). Safe to rerun: adds new repos and missing docs, never overwrites a
doc, and re-renders every router. Never creates, changes or reads a
CLAUDE.md; Claude Code loads .claude/rules/*.md alongside it.

Arguments:
  <name>                  project name, the router's heading
  <description>           one line: what the project is
  <repo>=<description>    one line: what a child repo is; required for a
                          repo without a rendered router, which otherwise
                          keeps its line

Reads:
  */.git                  each direct subdirectory holding one is a child repo
  <repo>/.claude/rules/forge.md
                          a rendered repo router keeps its description line
  <repo>/PRODUCT.md DESIGN.md
                          linked from that repo's router when present
  vault/Index.md <repo>/vault/Index.md
                          linked from that router when present
  $FORGE_TEMPLATES/       doc and router templates
                          (default ~/.claude/forge/templates)

Writes:
  .git                    git init, when the root is not a repo
  .gitignore              one /<repo>/ line per child repo
  .claude/rules/forge.md  the workspace router
  .forge/                 PROJECT RULES REJECTED STATE todo seeds; tracks/;
                          a single repo also gets the repo docs below
  <repo>/.claude/rules/forge.md
                          the repo router
  <repo>/.forge/          STACK INTEGRATIONS CONVENTIONS TESTING
                          ARCHITECTURE CONCERNS RULES REJECTED

Example:
  cd ~/Projects/acme
  forge-init acme "Acme apps." web="The web app."
EOF
    exit 0 ;;
  -*|'') usage ;;
esac
[ $# -ge 2 ] || usage
name=$1 desc=$2
shift 2

t=${FORGE_TEMPLATES:-$HOME/.claude/forge/templates}
out=
trap '[ -z "$out" ] || rm -f "$out"' EXIT
marker='<!-- rendered by forge-init -->'
rules=.claude/rules/forge.md
shared=(PROJECT RULES REJECTED todo seeds)
repo_docs=(STACK INTEGRATIONS CONVENTIONS TESTING ARCHITECTURE CONCERNS RULES REJECTED)

repos=()
for d in */; do
  [ -e "$d.git" ] && repos+=("${d%/}")
done

declare -A about
for a in "$@"; do
  case $a in *=*) ;; *) usage ;; esac
  r=${a%%=*}
  [[ " ${repos[*]} " == *" $r "* ]] || { echo "forge-init: $r is not a child repo" >&2; exit 2; }
  about[$r]=${a#*=}
done

for r in "${repos[@]}"; do
  f=$r/$rules
  if [ -e "$f" ] && [ -z "${about[$r]:-}" ]; then
    about[$r]=$(sed -n 3p "$f")
  fi
  [ -n "${about[$r]:-}" ] || { echo "forge-init: $r needs a description: $r=\"<one line>\"" >&2; exit 2; }
done

seed() {
  local dir=$1
  shift
  mkdir -p "$dir"
  for d; do
    [ -e "$dir/$d.md" ] || cp "$t/$d.md" "$dir/$d.md"
  done
}
router() {
  printf '# %s\n\n%s\n' "$1" "$2"
  shift 2
  "$@"
  printf '\n%s\n' "$marker"
}
render() {
  mkdir -p "$(dirname "$1")"
  out=$1.forge-init.tmp
  shift
  router "$@" >"$out"
  mv "$out" "${out%.forge-init.tmp}"
  ignored_warn "${out%.forge-init.tmp}"
  out=
}
ignored_warn() {
  ! git -C "$(dirname "$1")" check-ignore -q "$(basename "$1")" 2>/dev/null ||
    echo "forge-init: warning: git ignores $1; sessions on other clones will not get it" >&2
}
vault_row() {
  [ ! -e "$1/vault/Index.md" ] || printf '| Research, learning, reviews, notes, references | `vault/Index.md` |\n'
}
root_rows() {
  [ ! -e "$1/PRODUCT.md" ] || printf '| Product purpose, users, brand | `PRODUCT.md` |\n'
  [ ! -e "$1/DESIGN.md" ] || printf '| Visual design system | `DESIGN.md` |\n'
  vault_row "$1"
}
single_rows() {
  tail -n +4 "$t/CLAUDE.md"
  tail -n +7 "$t/repo-CLAUDE.md" | grep -vxFf "$t/CLAUDE.md"
  root_rows .
}
child_rows() {
  tail -n +4 "$t/repo-CLAUDE.md"
  root_rows "$1"
}
workspace_rows() {
  tail -n +4 "$t/CLAUDE.md"
  vault_row .
  printf '\n| Repo | Read |\n|---|---|\n'
  for r in "${repos[@]}"; do
    printf '| %s — %s | `%s/%s` |\n' "$r" "${about[$r]}" "$r" "$rules"
  done
}

[ -e .git ] || git init -q
mkdir -p .forge/tracks
if [ ${#repos[@]} -eq 0 ]; then
  seed .forge "${shared[@]}" "${repo_docs[@]}"
  render "$rules" "$name" "$desc" single_rows
  exit 0
fi

seed .forge "${shared[@]}"
touch .gitignore
[ -z "$(tail -c1 .gitignore)" ] || echo >> .gitignore
for r in "${repos[@]}"; do
  git check-ignore -q "$r/" || echo "/$r/" >> .gitignore
done
render "$rules" "$name" "$desc" workspace_rows
for r in "${repos[@]}"; do
  seed "$r/.forge" "${repo_docs[@]}"
  render "$r/$rules" "$r" "${about[$r]}" child_rows "$r"
done
