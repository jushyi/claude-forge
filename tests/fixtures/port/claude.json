{
  "numStartups": 42,
  "mcpServers": {
    "jbc": {
      "type": "stdio",
      "command": "forge-browser",
      "args": ["mcp"],
      "env": {"JBC_LOG": "env-value-jbc-7f3a"}
    },
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": ["start-mcp-server", "--context", "claude-code", "--project-from-cwd", "--mode", "no-memories"],
      "env": {"SERENA_LOG": "env-value-serena-7f3a"}
    },
    "playwright-headed": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {}
    },
    "example-mcp": {
      "type": "stdio",
      "command": "/Users/operator/.local/bin/example-mcp",
      "args": [],
      "env": {"EXAMPLE_TOKEN": "env-value-example-9c1d"}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.82", "--cdp-endpoint", "http://127.0.0.1:9222"],
      "env": {}
    }
  },
  "projects": {
    "~/Projects/ACME": {
      "mcpServers": {
        "playwright": {
          "type": "stdio",
          "command": "npx",
          "args": ["-y", "@playwright/mcp@0.0.82", "--cdp-endpoint", "http://127.0.0.1:9222"],
          "env": {"PW_KEY": "env-value-pw-acme-5d1e"}
        }
      }
    },
    "~/Projects/ACME/acme-hub": {
      "mcpServers": {
        "playwright": {
          "type": "stdio",
          "command": "npx",
          "args": ["-y", "@playwright/mcp@0.0.83", "--cdp-endpoint", "http://127.0.0.1:9222"],
          "env": {"PW_KEY": "env-value-pw-hub-8a2c"}
        }
      }
    },
    "~/Projects/forge": {
      "hasTrustDialogAccepted": true
    },
    "/Users/operator/Projects/demo": {
      "mcpServers": {
        "project-only": {
          "type": "stdio",
          "command": "project-only-mcp",
          "args": [],
          "env": {"PROJECT_KEY": "env-value-project-4b2e"}
        }
      }
    }
  }
}
