{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tasks"
  ],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "files",
          "deps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[0-9]+$"
          },
          "title": {
            "type": "string"
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-[0-9]{2,}$"
            }
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-[0-9]{2,}$"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "deps": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T[0-9]+$"
            }
          },
          "dep_reasons": {
            "type": "object",
            "propertyNames": {
              "pattern": "^T[0-9]+$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^(file .+|symbol .+)$"
            }
          },
          "test": {
            "enum": [
              "test-first",
              "exempt"
            ]
          },
          "exempt_reason": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "na_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "reason"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{2,}$"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "na_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "reason"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "reason"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
