{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature-verify",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manual_test",
    "result",
    "gaps"
  ],
  "properties": {
    "manual_test": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "result": {
      "enum": [
        "pass",
        "gaps"
      ]
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "gap"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "pattern": "^[0-9]{2,}$"
          },
          "gap": {
            "type": "string"
          }
        }
      }
    },
    "fixed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "gap",
          "fix"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "pattern": "^[0-9]{2,}$"
          },
          "gap": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "operator_ran": {
      "type": "boolean"
    },
    "stack_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo",
          "command",
          "passed"
        ],
        "properties": {
          "repo": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "review_trees": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
      }
    }
  }
}
